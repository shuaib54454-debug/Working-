rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: every collection must opt in explicitly below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Current product phase: one owner account only.
    // Employee accounts can be introduced later with a separate role model.
    function isOwner() {
      return request.auth != null &&
        request.auth.uid != null &&
        request.auth.token.email == "shuaib54454@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function ownsExistingDocument() {
      return isOwner() && resource != null && resource.data.ownerUid == request.auth.uid;
    }

    function ownsNewDocument() {
      return isOwner() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsUpdatedDocument() {
      return isOwner() &&
        ownsExistingDocument() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    // 1. Candidates
    match /candidates/{candidateId} {
      allow get, list: if ownsExistingDocument();
      allow create: if isValidId(candidateId) && ownsNewDocument();
      allow update: if isValidId(candidateId) && ownsUpdatedDocument();
      allow delete: if isValidId(candidateId) && ownsExistingDocument();
    }

    // 2. Operating expenses
    match /expenses/{expenseId} {
      allow get, list: if ownsExistingDocument();
      allow create: if isValidId(expenseId) && ownsNewDocument();
      allow update: if isValidId(expenseId) && ownsUpdatedDocument();
      allow delete: if isValidId(expenseId) && ownsExistingDocument();
    }

    // 3. Agency settings: only the owner's UID document is accessible.
    match /settings/{settingId} {
      allow get: if isOwner() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if isOwner() &&
        settingId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid;
    }

    // 4. No employee/admin registry in the single-owner phase.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // 5. System health/configuration is owner-only.
    match /_system/{docId} {
      allow read, write: if isOwner();
    }

    // 6. Audit/activity log is private to the owner in the current phase.
    match /activities/{activityId} {
      allow get, list: if isOwner();
      allow create: if isOwner() && isValidId(activityId);
      allow update, delete: if isOwner();
    }
  }
}
