rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Bootstrapped Admin check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "shuaib54454@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Checks that the document is owned by the current authenticated user or is unassigned/admin
    function isDocOwner() {
      return isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          !('ownerUid' in resource.data) || 
          resource.data.ownerUid == null || 
          resource.data.ownerUid == '' || 
          resource.data.ownerUid == request.auth.uid
        ))
      );
    }

    // Checks that the created document has a valid ownerUid matching the user's UID or admin
    function isCreatingWithOwner() {
      return isSignedIn() && (
        isAdmin() ||
        (
          'ownerUid' in request.resource.data &&
          request.resource.data.ownerUid is string &&
          (request.resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == '')
        )
      );
    }

    // Ensures the user is the owner AND that ownerUid can be adopted or maintained
    function isUpdatingWithOwner() {
      return isSignedIn() && (
        isAdmin() ||
        isDocOwner() ||
        (
          'ownerUid' in request.resource.data &&
          request.resource.data.ownerUid == request.auth.uid
        )
      );
    }

    // 1. Candidates Collection
    match /candidates/{candidateId} {
      allow get, list: if isSignedIn() && (isDocOwner() || isAdmin());
      allow create: if isCreatingWithOwner() && isValidId(candidateId);
      allow update: if isUpdatingWithOwner() && isValidId(candidateId);
      allow delete: if (isDocOwner() || isAdmin()) && isValidId(candidateId);
    }

    // 2. Operating Expenses Collection
    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && (isDocOwner() || isAdmin());
      allow create: if isCreatingWithOwner() && isValidId(expenseId);
      allow update: if isUpdatingWithOwner() && isValidId(expenseId);
      allow delete: if (isDocOwner() || isAdmin()) && isValidId(expenseId);
    }

    // 3. Agency Settings Collection
    match /settings/{settingId} {
      allow get, list: if isSignedIn() && (
        isDocOwner() ||
        isAdmin() ||
        settingId == request.auth.uid ||
        settingId == 'agency_config'
      );
      allow create: if isSignedIn() && isValidId(settingId);
      allow update: if isSignedIn() && isValidId(settingId);
      allow delete: if isSignedIn() && isValidId(settingId) && (isDocOwner() || isAdmin());
    }

    // 4. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. System Health Check
    match /_system/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}


