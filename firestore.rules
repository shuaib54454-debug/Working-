rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: every collection must opt in explicitly below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "shuaib54454@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Existing document must belong to the caller unless the caller is an admin.
    function ownsExistingDocument() {
      return isSignedIn() && resource != null && resource.data.ownerUid == request.auth.uid;
    }

    // New candidate/expense documents must be explicitly owned by the caller.
    function ownsNewDocument() {
      return isSignedIn() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    // Updates must preserve ownership. A caller can never change ownerUid to another UID.
    function ownsUpdatedDocument() {
      return isSignedIn() &&
        ownsExistingDocument() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    // 1. Candidates
    match /candidates/{candidateId} {
      allow get, list: if isAdmin() || ownsExistingDocument();
      allow create: if isAdmin() || (isValidId(candidateId) && ownsNewDocument());
      allow update: if isAdmin() || (isValidId(candidateId) && ownsUpdatedDocument());
      allow delete: if isAdmin() || (isValidId(candidateId) && ownsExistingDocument());
    }

    // 2. Operating expenses
    match /expenses/{expenseId} {
      allow get, list: if isAdmin() || ownsExistingDocument();
      allow create: if isAdmin() || (isValidId(expenseId) && ownsNewDocument());
      allow update: if isAdmin() || (isValidId(expenseId) && ownsUpdatedDocument());
      allow delete: if isAdmin() || (isValidId(expenseId) && ownsExistingDocument());
    }

    // 3. Agency settings are isolated by document ID/ownerUid.
    match /settings/{settingId} {
      allow get: if isAdmin() || (
        isSignedIn() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid
      );
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        settingId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        settingId == request.auth.uid &&
        resource != null &&
        resource.data.ownerUid == request.auth.uid
      );
    }

    // 4. Admin registry: users can only read their own admin record; admins can manage all.
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && adminId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 5. System health document is not a public write surface.
    match /_system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
