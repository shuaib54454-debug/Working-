# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Kept strictly server-side (never exposed to browser or mobile client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Must match firebase-applet-config.json projectId.
FIREBASE_PROJECT_ID="crack-petal-506818-c8"

# PORT: The port the server listens on (defaults to 8080 on Cloud Run, 3000 locally).
PORT=8080

# APP_URL: Primary browser origin allowed to call the backend cross-origin.
APP_URL="https://your-production-app.example.com"

# Optional comma-separated additional browser origins.
CORS_ORIGINS=""
