# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Kept strictly server-side (never exposed to browser or mobile client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Firebase Project ID for verifying user ID tokens server-side.
FIREBASE_PROJECT_ID="gen-lang-client-0213401665"

# PORT: The port the server listens on (defaults to 8080 on Cloud Run, 3000 locally).
PORT=8080

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-production-cloud-run-service.run.app"
