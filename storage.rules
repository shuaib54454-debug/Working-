rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny: every storage path must opt in explicitly below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Current product phase: one owner account only.
    // Employee accounts can be introduced later with a separate role model.
    function isOwner() {
      return request.auth != null &&
        request.auth.uid != null &&
        request.auth.token.email == "shuaib54454@gmail.com";
    }

    function isAllowedDocumentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf');
    }

    // Worker documents are available only to the single owner. Existing ownership
    // is also checked on overwrite so metadata cannot be changed to bypass isolation.
    match /workers/{candidateId}/{folder}/{fileName} {
      allow read: if isOwner() && resource != null && resource.metadata.ownerUid == request.auth.uid;

      allow write: if isOwner() &&
        request.resource.size < 15 * 1024 * 1024 &&
        isAllowedDocumentType() &&
        request.resource.metadata.ownerUid == request.auth.uid &&
        (resource == null || resource.metadata.ownerUid == request.auth.uid);

      allow delete: if isOwner() && resource != null && resource.metadata.ownerUid == request.auth.uid;
    }
  }
}
